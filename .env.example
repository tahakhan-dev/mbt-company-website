# ============================================================================
# MBT website — environment template
# Copy to .env.local for local dev; set the same keys in Netlify → Site
# configuration → Environment variables for production.
# NEVER commit .env.local or the service-account JSON.
# ============================================================================

# ---- Firebase Admin SDK (server only — full Firestore/Auth access) --------
# From the service-account JSON (Project settings → Service accounts).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes; newlines must be the two characters \n (the code unescapes them).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Firebase web config (safe to expose; used ONLY for admin sign-in) ----
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# ---- Site identity ---------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=MBT
# Production canonical origin (no trailing slash). Used for SEO + origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Seeded admin (scripts/seed.mts creates/updates this user) -------------
ADMIN_EMAIL=you@your-domain.com
ADMIN_PASSWORD=choose-a-strong-password

# ---- Analytics -------------------------------------------------------------
# Random secret used to hash visitor IPs (raw IPs are never stored).
IP_HASH_SALT=generate-a-long-random-string
# IPinfo Lite token (free) for country + ASN/company enrichment.
IPINFO_TOKEN=
# Optional: collector endpoint override for the tracker (defaults to /api/collect).
NEXT_PUBLIC_COLLECT_ENDPOINT=

# ---- Cloudinary (media uploads; site works fully without it) ---------------
# Cloud name from the Cloudinary console dashboard (REQUIRED for uploads).
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Optional integrations (all off when empty) -----------------------------
# Resend: transactional email alerts for new leads.
RESEND_API_KEY=
# Where lead alerts are sent (defaults to the settings/site contact email).
LEAD_ALERT_EMAIL=
# Cloudflare Turnstile spam protection for the lead form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Testing/ops ------------------------------------------------------------
# Prefixes EVERY Firestore collection (e.g. "e2e_") so tests never touch
# real content. Leave empty in production.
FIRESTORE_COLLECTION_PREFIX=
