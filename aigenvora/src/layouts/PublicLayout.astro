---
import { ClientRouter } from "astro:transitions";
import Nav from "~/components/public/Nav.astro";
import Footer from "~/components/public/Footer.astro";
import "~/styles/tokens.css";
import "~/styles/base.css";

interface Props {
  title: string;
  description: string;
  /** Optional per-route scene config forwarded to the engine. */
  accent?: string;
  moduleIndex?: number;
  sceneMode?: "atlas" | "dormant" | "build" | "decompose" | "rest";
}

const { title, description, accent, moduleIndex, sceneMode } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} — Aigenvora`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/GeneralSans-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Aigenvora",
        url: "https://aigenvora.com",
        description:
          "AI-powered software development: agents, products, data systems and custom platforms.",
        email: "hello@aigenvora.com",
      })}
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div
      transition:persist="engine-stage"
      class="engine-stage"
      data-engine-root
      data-accent={accent}
      data-module-index={moduleIndex}
      data-scene-mode={sceneMode}
    >
      <canvas data-engine-canvas aria-hidden="true"></canvas>
    </div>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import { bootEngine } from "~/engine/boot";

      bootEngine();

      // Masked reveals: IntersectionObserver, disabled under reduced motion.
      function armReveals(): void {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = document.querySelectorAll<HTMLElement>("[data-reveal]:not(.is-revealed)");
        if (reduced) {
          els.forEach((el) => el.classList.add("is-revealed"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.35 },
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener("astro:page-load", armReveals);
    </script>

    <style is:global>
      .engine-stage {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
      }
      .engine-stage canvas {
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 900ms var(--ease-drift);
      }
      .engine-stage canvas.engine-live {
        opacity: 1;
      }
      .engine-stage canvas.engine-idle {
        opacity: 0;
      }
      html[data-engine="failed"] .engine-stage {
        display: none;
      }

      /* Designed Tier C posters: visible by default (no JS), hidden once the
         engine tier is A/B, restored on permanent failure. */
      html[data-tier="A"] [data-poster],
      html[data-tier="B"] [data-poster] {
        display: none;
      }
      html[data-engine="failed"] [data-poster] {
        display: block;
      }

      [data-reveal] {
        opacity: 0;
        transform: translateY(1.2rem);
        transition:
          opacity var(--dur-reveal) var(--ease-out-fast),
          transform var(--dur-reveal) var(--ease-out-fast);
      }
      [data-reveal].is-revealed {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </body>
</html>
