---
/**
 * Aigenvora identity — code-drawn, original (no AI generation, per ledger).
 * The badge mark is the engine motif compressed into a monogram: a machined
 * ring (the module ring), a rising conduit stroke forming the "A" counter,
 * and the warm core at the crossing — reads at 16px like an Audi/BMW-class
 * short-form mark.
 *
 * variant="mark"     → badge only (nav, favicon, loader)
 * variant="lockup"   → badge + AIGENVORA wordmark
 */
interface Props {
  variant?: "mark" | "lockup";
  size?: number;
  class?: string;
}
const { variant = "lockup", size = 28, class: cls = "" } = Astro.props;
---

<span class:list={["logo", cls]} style={`--logo-size:${size}px`}>
  <svg
    class="mark"
    viewBox="0 0 64 64"
    width={size}
    height={size}
    role="img"
    aria-label="Aigenvora"
  >
    <!-- machined ring -->
    <circle cx="32" cy="32" r="27" fill="none" stroke="currentColor" stroke-width="4.5" data-logo-ring></circle>
    <!-- the A: two conduit strokes rising to an apex above center -->
    <path
      d="M17 46 L32 15 L47 46"
      fill="none"
      stroke="currentColor"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      data-logo-a
    ></path>
    <!-- crossbar as a docked module -->
    <rect x="26.4" y="35" width="11.2" height="4.6" rx="1.4" fill="currentColor" data-logo-bar></rect>
    <!-- warm core at the apex -->
    <circle cx="32" cy="15" r="3.4" fill="var(--accent-warm, #FFB84D)" data-logo-core></circle>
  </svg>
  {
    variant === "lockup" && (
      <span class="word" aria-hidden="true">
        AIGENVORA
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    color: currentColor;
    line-height: 1;
  }
  .mark {
    display: block;
    flex: none;
  }
  .word {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.16em;
    font-size: calc(var(--logo-size) * 0.56);
    transform: translateY(0.04em);
  }
</style>
