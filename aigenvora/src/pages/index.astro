---
import PublicLayout from "~/layouts/PublicLayout.astro";
import FrameStage from "~/components/public/FrameStage.astro";
import Poster from "~/components/public/Poster.astro";
import { getServices, getSettings } from "~/lib/content/queries";
import { MANIFESTO, MVP_STEPS } from "~/lib/content/defaults";
import { getPortfolio } from "~/lib/content/portfolio";
import { getTestimonials } from "~/lib/content/queries";

const services = await getServices();
const site = await getSettings();
const testimonials = await getTestimonials();
const videoReviews = testimonials.filter((t) => t.videoUrl);
const featured = getPortfolio()
  .filter((p) => p.heroImage)
  .slice(0, 3);

const transformPairs = [
  ["Customer messages", "answered with your rules"],
  ["Documents", "read, validated, filed"],
  ["Bookings", "confirmed while you sleep"],
  ["Invoices", "reconciled, chased, reported"],
  ["CRM records", "one truth, every system"],
  ["Friday reports", "assembled overnight"],
] as const;
---

<PublicLayout
  title="AI-Powered Software Development"
  description="Aigenvora designs, builds and operates AI-powered software: agents, products, data systems and custom platforms built by one senior team."
>
  <!-- Ch.1 — Arrival (state: Unresolved) -->
  <section class="ch-arrival" data-chapter="arrival">
    <div class="container grid">
      <div class="copy">
        <p class="mono-label" data-entrance style="--ent-delay:.1s">{site.descriptor}</p>
        <h1>
          <span data-entrance style="--ent-delay:.25s">We turn ambitious ideas</span>
          <span data-entrance style="--ent-delay:.37s">and broken workflows</span>
          <span data-entrance style="--ent-delay:.49s">into software that moves.</span>
        </h1>
        <p class="support" data-entrance style="--ent-delay:.62s">
          AI agents, products, data systems and custom platforms — built by one senior team.
        </p>
        <div class="actions" data-entrance style="--ent-delay:.74s">
          <a class="cta cta--warm" href="/contact">{site.cta}</a>
          <a class="cta" href="/work">Explore our work</a>
        </div>
        <p class="mono-label substat" data-entrance style="--ent-delay:.88s">
          Thirteen products in production · Twelve ways to build yours
        </p>
      </div>
      <div class="stage" data-entrance style="--ent-delay:.4s">
        <FrameStage tl="AIGENVORA ENGINE" tr="" bl="" br="FIG. 01">
          <span slot="tr-live" class="visually-hidden"></span>
          <Poster state="unresolved" label="The Aigenvora Engine — twelve modules, unresolved" />
        </FrameStage>
        <p class="readout readout--tr mono-label" aria-hidden="true">
          STATE: <span data-readout-state>UNRESOLVED</span>
        </p>
        <p class="readout readout--bl mono-label" aria-hidden="true">
          MODULES <span data-readout-modules>00</span>/12
        </p>
      </div>
    </div>
  </section>

  <!-- Ch.2 — The problem (chamber) -->
  <section class="ch-problem" data-chapter="problem">
    <div class="container">
      <p class="mono-label chapter-mark" data-choreo data-choreo-start="0.12" data-choreo-end="0.18">
        02 · The problem
      </p>
      <div class="manifesto">
        {
          MANIFESTO.map((line, i) => (
            <p
              class="line scrim"
              data-choreo="words"
              data-choreo-start={String(0.2 + i * 0.2)}
              data-choreo-end={String(0.3 + i * 0.2)}
            >
              {line}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Ch.3 — The system: one service per act, full stage -->
  <section class="ch-system" data-chapter="system" id="system">
    <div class="pin">
      <div class="container sys-stage">
        <p class="mono-label sys-eyebrow">03 · The system — twelve ways to make software move</p>
        <div class="acts" data-step-stage="system" data-step-count="12">
          {
            services.map((s, i) => (
              <div class="act" data-step={i}>
                <span class="act-num" aria-hidden="true">{String(s.order).padStart(2, "0")}</span>
                <h3 class="act-name">
                  <span class="mask"><span class="part">{s.name}</span></span>
                </h3>
                <p class="act-outcome">
                  <span class="mask"><span class="part">{s.outcome}</span></span>
                </p>
                <a class="act-link mono-label" href={`/services/${s.slug}`}>Explore the service →</a>
              </div>
            ))
          }
        </div>
        <div class="sys-progress mono-label" aria-hidden="true">
          <span data-step-counter>01</span>/12
          <span class="bar"><span class="fill" data-step-bar></span></span>
        </div>
      </div>
    </div>
    <!-- Mobile / reduced-motion index -->
    <ol class="sys-index container">
      {
        services.map((s) => (
          <li>
            <a href={`/services/${s.slug}`}>
              <span class="mono-label">{String(s.order).padStart(2, "0")}</span>
              <span class="name">{s.name}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Ch.4 — For founders: the staged build -->
  <section class="ch-founders" data-chapter="founders">
    <div class="pin">
      <div class="container founders-stage">
        <p class="mono-label founders-eyebrow" data-choreo data-choreo-start="0.02" data-choreo-end="0.08">
          04 · For founders
        </p>
        <h2 class="founders-h2" data-choreo data-choreo-start="0.04" data-choreo-end="0.12">
          From first sketch to a product people can finally use.
        </h2>
        <div class="beats" data-step-stage="founders" data-step-count="6">
          {
            MVP_STEPS.map((s, i) => (
              <div class="beat" data-step={i}>
                <span class="act-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h3><span class="mask"><span class="part">{s.name}</span></span></h3>
                <p class="beat-body"><span class="mask"><span class="part">{s.body}</span></span></p>
              </div>
            ))
          }
        </div>
        <p class="belief mono-label">An MVP is not a demo. It's the first honest version of your business.</p>
        <a class="cta cta--warm founders-cta" href="/mvps">Plan your MVP</a>
      </div>
    </div>
  </section>

  <!-- Ch.5 — Transformation -->
  <section class="ch-transform" data-chapter="transformation">
    <div class="container">
      <p class="mono-label chapter-mark" data-choreo data-choreo-start="0.1" data-choreo-end="0.16">
        05 · Before / after
      </p>
      <h2 class="scrim" data-choreo data-choreo-start="0.14" data-choreo-end="0.24">
        Before: six tools and a person in the middle.<br />After: one system that runs the routine.
      </h2>
      <dl class="pairs">
        {
          transformPairs.map(([before, after], i) => (
            <div
              class="pair"
              data-choreo
              data-choreo-start={String(0.26 + i * 0.05)}
              data-choreo-end={String(0.34 + i * 0.05)}
            >
              <dt>{before}</dt>
              <dd>{after}</dd>
            </div>
          ))
        }
      </dl>
      <p class="support scrim" data-choreo data-choreo-start="0.6" data-choreo-end="0.7">
        While your team does the work only people can do.
      </p>
    </div>
  </section>

  <!-- Ch.6 — Work (proof) -->
  <section class="ch-work" data-chapter="work">
    <div class="container">
      <p class="mono-label" data-choreo data-choreo-start="0.12" data-choreo-end="0.2">06 · Work</p>
      <h2 data-choreo data-choreo-start="0.16" data-choreo-end="0.26">Systems in the world.</h2>
      <p class="support" data-choreo data-choreo-start="0.22" data-choreo-end="0.3">
        Thirteen products our team has built and operated — AI agents, document processing,
        booking, CRM, monitoring, security. Each one is a working business, not a mockup.
      </p>
      <div class="work-strip">
        {
          featured.map((p, i) => (
            <a
              class="work-card"
              href={`/work/${p.slug}`}
              data-choreo
              data-choreo-start={String(0.26 + i * 0.06)}
              data-choreo-end={String(0.36 + i * 0.06)}
            >
              <img src={p.heroImage} alt={`${p.name} product interface`} loading="lazy" width="600" height="375" />
              <span class="wc-name">{p.name}</span>
              <span class="wc-cat mono-label">{p.category}</span>
            </a>
          ))
        }
      </div>
      <a class="cta" href="/work" data-choreo data-choreo-start="0.46" data-choreo-end="0.54">
        Explore all 13 products →
      </a>
    </div>
  </section>

  <!-- Client voices -->
  {
    testimonials.length > 0 && (
      <section class="ch-voices" data-chapter="voices">
        <div class="container">
          <p class="mono-label" data-choreo data-choreo-start="0.1" data-choreo-end="0.18">
            Client voices
          </p>
          <h2 data-choreo data-choreo-start="0.14" data-choreo-end="0.24">
            What it's like to build with us.
          </h2>
          <div class="voices">
            {testimonials.slice(0, 3).map((t, i) => (
              <blockquote
                class="voice"
                data-choreo
                data-choreo-start={String(0.22 + i * 0.07)}
                data-choreo-end={String(0.32 + i * 0.07)}
              >
                <p class="quote">“{t.quote}”</p>
                <footer>
                  <b>{t.name}</b>
                  <span class="mono-label">
                    {t.title}
                    {t.company ? ` · ${t.company}` : ""}
                  </span>
                </footer>
              </blockquote>
            ))}
          </div>
          {videoReviews.length > 0 && (
            <div class="video-reviews">
              <p class="mono-label" data-reveal>Video reviews</p>
              <div class="vr-grid">
                {videoReviews.map((t) => (
                  <figure class="vr" data-reveal>
                    <video controls preload="none" src={t.videoUrl} />
                    <figcaption>
                      <b>{t.name}</b> · {t.company}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- Ch.7 — People and method -->
  <section class="ch-people" data-chapter="people">
    <div class="container">
      <p class="mono-label" data-choreo data-choreo-start="0.1" data-choreo-end="0.18">
        07 · People &amp; method
      </p>
      <h2 data-choreo data-choreo-start="0.14" data-choreo-end="0.24">Senior people, start to ship.</h2>
      <div class="statements">
        <p data-choreo data-choreo-start="0.24" data-choreo-end="0.32">The people who scope your product are the people who build it.</p>
        <p data-choreo data-choreo-start="0.3" data-choreo-end="0.38">You get one channel, short loops and working software every week.</p>
        <p data-choreo data-choreo-start="0.36" data-choreo-end="0.44">You own the code, the infrastructure and the roadmap.</p>
        <p data-choreo data-choreo-start="0.42" data-choreo-end="0.5">Your repo, your cloud, your name on everything. We work in your channels, not around them.</p>
      </div>
      <div class="method" data-choreo data-choreo-start="0.46" data-choreo-end="0.56">
        <p class="mono-label">Delivery method</p>
        <ol>
          <li><b>Map</b> — sit in the real process, find where hours go.</li>
          <li><b>Design</b> — smallest valuable system, risk behind checkpoints.</li>
          <li><b>Build</b> — working software weekly, rehearsed against real cases.</li>
          <li><b>Operate</b> — monitored, reviewed, improved after launch.</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Ch.8 — Resolution -->
  <section class="ch-resolution" data-chapter="resolution">
    <div class="container">
      <p class="mono-label" data-choreo data-choreo-start="0.2" data-choreo-end="0.28">08 · Next</p>
      <h2 class="scrim" data-choreo="words" data-choreo-start="0.26" data-choreo-end="0.4">
        Build what moves next.
      </h2>
      <p class="support scrim" data-choreo data-choreo-start="0.38" data-choreo-end="0.46">
        Tell us what's slow, stuck or still an idea. We'll tell you what we'd build first.
      </p>
      <div class="actions" data-choreo data-choreo-start="0.44" data-choreo-end="0.52">
        <a class="cta cta--warm" href="/contact">{site.cta}</a>
        <a class="cta cta--ghost" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      </div>
      <p class="mono-label risk" data-choreo data-choreo-start="0.5" data-choreo-end="0.58">
        A first conversation costs nothing and usually saves a quarter.
      </p>
    </div>
  </section>

  <script>
    import { chapterProgress, measureChapters, type ChapterRange } from "~/engine/scroll";

    /** Step stages (atlas acts, founder beats): active index derives from the
     *  same chapter progress the engine reads. */
    function armSteps(): () => void {
      const stages = document.querySelectorAll<HTMLElement>("[data-step-stage]");
      if (stages.length === 0) return () => {};
      let chapters: ChapterRange[] = measureChapters();
      const remeasure = () => {
        chapters = measureChapters();
      };
      window.addEventListener("resize", remeasure, { passive: true });

      let raf = 0;
      const tick = (): void => {
        raf = requestAnimationFrame(tick);
        const scrollY = window.scrollY;
        const vh = window.innerHeight;
        stages.forEach((stage) => {
          const name = stage.dataset["stepStage"]!;
          const count = Number(stage.dataset["stepCount"] ?? "1");
          const range = chapters.find((c) => c.name === name);
          if (!range) return;
          const p = chapterProgress(range, scrollY, vh);
          // Steps occupy the middle band of the pin so entry/exit stay clean.
          const band = Math.min(0.999, Math.max(0, (p - 0.12) / 0.76));
          const active = Math.min(count - 1, Math.floor(band * count));
          stage.querySelectorAll<HTMLElement>("[data-step]").forEach((el, i) => {
            el.classList.toggle("is-active", i === active);
            el.classList.toggle("is-past", i < active);
          });
          const section = stage.closest("section");
          const counter = section?.querySelector<HTMLElement>("[data-step-counter]");
          if (counter) counter.textContent = String(active + 1).padStart(2, "0");
          const bar = section?.querySelector<HTMLElement>("[data-step-bar]");
          if (bar) bar.style.width = `${((active + 1) / count) * 100}%`;
        });
      };
      tick();
      return () => {
        cancelAnimationFrame(raf);
        window.removeEventListener("resize", remeasure);
      };
    }

    let disarm: (() => void) | null = null;
    document.addEventListener("astro:page-load", () => {
      disarm?.();
      disarm = armSteps();
    });
    document.addEventListener("astro:before-swap", () => {
      disarm?.();
      disarm = null;
    });
  </script>
</PublicLayout>

<style>
  section h2 {
    font-size: var(--text-xl);
    font-weight: 600;
  }

  /* ---- Ch.1 ---- */
  .ch-arrival {
    min-height: 150vh;
    padding-top: var(--space-stage);
  }
  .grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-3);
    align-items: start;
    min-height: 78vh;
  }
  .grid {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  h1 {
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    margin-block: var(--space-2);
    font-weight: 600;
    line-height: 1.04;
    max-width: 15ch;
  }
  h1 span {
    display: inline-block;
    margin-right: 0.24em;
  }
  .support {
    color: var(--ink-2);
    font-size: var(--text-lg);
    max-width: 46ch;
  }
  .actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }
  .substat {
    margin-top: var(--space-2);
  }
  .stage {
    min-height: 56vh;
    position: sticky;
    top: 12vh;
    display: grid;
  }
  .readout {
    position: absolute;
    margin: 0;
    font-size: 0.62rem;
  }
  .readout--tr {
    top: 0.5rem;
    right: 0.65rem;
  }
  .readout--bl {
    bottom: 0.5rem;
    left: 0.65rem;
  }

  /* ---- Ch.2 chamber ---- */
  .ch-problem {
    background: transparent;
    color: #f2f3f8;
    min-height: 220vh;
    padding-block: var(--space-5);
  }
  .ch-problem .chapter-mark {
    color: #9da4b3;
  }
  :global(html[data-tier="C"]) .ch-problem,
  :global(html:not([data-tier])) .ch-problem,
  :global(html[data-engine="failed"]) .ch-problem {
    background: #030407 url("/media/hf01-chamber.webp") center / cover no-repeat fixed;
  }
  .manifesto {
    display: grid;
    gap: 32vh;
    padding-block: 12vh 24vh;
  }
  .manifesto .line {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    max-width: 28ch;
  }
  .manifesto .line:nth-child(2) {
    margin-left: clamp(0px, 18vw, 320px);
  }

  /* ---- Ch.3 acts ---- */
  .ch-system {
    height: 400vh;
  }
  .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .sys-stage {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .sys-eyebrow {
    position: absolute;
    top: 14vh;
    left: var(--gutter);
  }
  .acts {
    position: absolute;
    inset: 0;
  }
  .act {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    max-width: min(46vw, 560px);
    pointer-events: none;
  }
  .act-num {
    position: absolute;
    top: -22vh;
    left: -0.04em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(6rem, 17vh, 11rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--hairline);
    opacity: 0;
    transform: translateY(0.25em);
    transition:
      opacity 500ms var(--ease-out-fast),
      transform 500ms var(--ease-out-fast);
  }
  .act .mask {
    display: block;
    overflow: hidden;
  }
  .act .part {
    display: block;
    transform: translateY(110%);
    transition: transform 520ms var(--ease-mech);
  }
  .act-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 3.6vw, 3.2rem);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    margin: 0 0 0.6rem;
  }
  .act-outcome {
    color: var(--ink-2);
    font-size: var(--text-lg);
    max-width: 38ch;
    margin: 0 0 1.1rem;
  }
  .act-outcome .part {
    transition-delay: 70ms;
  }
  .act-link {
    color: var(--accent-electric);
    text-decoration: none;
    opacity: 0;
    transition: opacity 400ms var(--ease-out-fast) 160ms;
  }
  .act.is-active {
    pointer-events: auto;
  }
  .act.is-active .part {
    transform: translateY(0);
  }
  .act.is-active .act-num {
    opacity: 1;
    transform: translateY(0);
  }
  .act.is-active .act-link {
    opacity: 1;
  }
  .act.is-past .part {
    transform: translateY(-110%);
  }
  .sys-progress {
    position: absolute;
    bottom: 10vh;
    left: var(--gutter);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .bar {
    display: inline-block;
    width: 140px;
    height: 1px;
    background: var(--hairline);
    position: relative;
  }
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--accent-electric);
    width: 0;
    transition: width 400ms var(--ease-mech);
  }
  .sys-index {
    display: none;
  }

  /* ---- Ch.4 founders build ---- */
  .ch-founders {
    height: 320vh;
  }
  .founders-stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
  }
  .founders-eyebrow {
    position: absolute;
    top: 10vh;
    left: var(--gutter);
  }
  .founders-h2 {
    position: absolute;
    top: 14vh;
    left: var(--gutter);
    max-width: 26ch;
    font-size: clamp(1.3rem, 2.2vw, 1.9rem);
  }
  .beats {
    position: absolute;
    inset: 0;
  }
  .beat {
    position: absolute;
    left: var(--gutter);
    top: 58%;
    transform: translateY(-50%);
    max-width: min(38vw, 440px);
  }
  .beat h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    letter-spacing: var(--tracking-display);
    margin: 0 0 0.5rem;
  }
  .beat .mask {
    display: block;
    overflow: hidden;
  }
  .beat .part {
    display: block;
    transform: translateY(110%);
    transition: transform 500ms var(--ease-mech);
  }
  .beat-body {
    color: var(--ink-2);
    max-width: 40ch;
    margin: 0;
  }
  .beat-body .part {
    transition-delay: 70ms;
  }
  .beat .act-num {
    top: -13vh;
    font-size: clamp(4.5rem, 12vh, 8rem);
  }
  .beat.is-active .part {
    transform: translateY(0);
  }
  .beat.is-active .act-num {
    opacity: 1;
    transform: translateY(0);
  }
  .beat.is-past .part {
    transform: translateY(-110%);
  }
  .belief {
    position: absolute;
    bottom: 15vh;
    right: var(--gutter);
    left: auto;
    max-width: 34ch;
    text-align: right;
  }
  .founders-cta {
    position: absolute;
    bottom: 7vh;
    left: var(--gutter);
  }

  /* ---- Ch.5 ---- */
  .ch-transform {
    background: transparent;
    color: #f2f3f8;
    min-height: 180vh;
    padding-block: var(--space-5);
  }
  .ch-transform .chapter-mark,
  .ch-transform .support {
    color: #9da4b3;
  }
  :global(html[data-tier="C"]) .ch-transform,
  :global(html:not([data-tier])) .ch-transform,
  :global(html[data-engine="failed"]) .ch-transform {
