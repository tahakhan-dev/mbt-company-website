---
import PublicLayout from "~/layouts/PublicLayout.astro";
import FrameStage from "~/components/public/FrameStage.astro";
import Poster from "~/components/public/Poster.astro";

const useCases = [
  {
    head: "Inbox that answers itself",
    body: "Customer and supplier messages triaged, drafted and — where you allow it — sent, with your tone and your rules.",
  },
  {
    head: "Documents that file themselves",
    body: "Invoices, contracts and forms read, validated and pushed into the systems that need them, with a human review lane.",
  },
  {
    head: "Operations that run the routine",
    body: "Bookings confirmed, records reconciled, reports assembled overnight — agents that finish tasks, not demos that start them.",
  },
];

const process = [
  { step: "01", name: "Map the workflow", body: "We sit in the real process and find where hours actually go." },
  { step: "02", name: "Design the agent's job", body: "Narrow scope, explicit rules, human checkpoints where risk lives." },
  { step: "03", name: "Build and rehearse", body: "The agent runs shadow mode against real cases before it touches anything." },
  { step: "04", name: "Operate and improve", body: "Monitoring, escalation paths and monthly reviews of what it handled." },
];
---

<PublicLayout
  title="AI Agents & Business Automation"
  description="Hand your repetitive workflows to agents that actually finish them. Aigenvora designs, builds and operates business automation with human checkpoints."
  moduleIndex={0}
>
  <article>
    <header class="hero" data-chapter="service-hero">
      <div class="container grid">
        <div class="copy">
          <p class="mono-label" data-reveal>Service 01 / 12 · AI Agents &amp; Business Automation</p>
          <h1 data-reveal>Hand your repetitive workflows to agents that actually finish them.</h1>
          <p class="support" data-reveal>
            Not chat widgets. Working software that reads, decides, acts and reports — inside the
            tools your company already runs, with people in control of the risky parts.
          </p>
        </div>
        <div class="stage">
          <FrameStage tl="MODULE 01" tr="STATE: ACTIVE" bl="AUTOMATION" br="FIG. 01">
            <Poster state="focus" label="Module 01 isolated under studio light" />
          </FrameStage>
        </div>
      </div>
    </header>

    <section class="usecases container" data-chapter="service-usecases">
      <p class="mono-label" data-reveal>What it looks like in a real business</p>
      <div class="cases">
        {
          useCases.map((c, i) => (
            <div class="case" data-reveal>
              <p class="mono-label">{String(i + 1).padStart(2, "0")}</p>
              <h2>{c.head}</h2>
              <p>{c.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="process container" data-chapter="service-process">
      <p class="mono-label" data-reveal>How we get there</p>
      <ol>
        {
          process.map((p) => (
            <li data-reveal>
              <span class="mono-label">{p.step}</span>
              <h2>{p.name}</h2>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="endcap container" data-chapter="service-end">
      <h2 data-reveal>Which workflow costs you the most hours?</h2>
      <div class="actions" data-reveal>
        <a class="cta cta--warm" href="/contact">Build with Aigenvora</a>
        <a class="cta" href="/">Back to the system</a>
      </div>
    </section>
  </article>
</PublicLayout>

<style>
  .hero {
    padding-block: var(--space-stage) var(--space-4);
  }
  .grid {
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: var(--space-3);
    align-items: start;
  }
  h1 {
    font-size: var(--text-display);
    margin-block: var(--space-2);
    max-width: 16ch;
  }
  .support {
    color: var(--ink-2);
    font-size: var(--text-lg);
    max-width: 46ch;
  }
  .stage {
    min-height: 52vh;
  }

  .usecases {
    padding-block: var(--space-4);
  }
  .cases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .case h2 {
    font-size: var(--text-xl);
    margin-block: var(--space-1) var(--space-2);
    max-width: 14ch;
  }
  .case p:last-child {
    color: var(--ink-2);
  }
  /* Editorial rhythm — not three identical centered columns. */
  .case:nth-child(2) {
    margin-top: var(--space-4);
  }
  .case:nth-child(3) {
    margin-top: var(--space-2);
  }

  .process {
    padding-block: var(--space-4);
    border-top: 1px solid var(--hairline-soft);
  }
  .process ol {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .process h2 {
    font-size: var(--text-lg);
    margin-block: var(--space-1);
  }
  .process p:last-child {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .endcap {
    padding-block: var(--space-5);
  }
  .endcap h2 {
    font-size: var(--text-xl);
    max-width: 24ch;
    margin-bottom: var(--space-3);
  }
  .actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .grid,
    .cases,
    .process ol {
      grid-template-columns: 1fr;
    }
    .stage {
      order: -1;
      min-height: 42vh;
    }
    .case:nth-child(2),
    .case:nth-child(3) {
      margin-top: 0;
    }
  }
</style>
