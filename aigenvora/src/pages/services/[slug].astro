---
import PublicLayout from "~/layouts/PublicLayout.astro";
import FrameStage from "~/components/public/FrameStage.astro";
import Poster from "~/components/public/Poster.astro";
import { getService, getServices } from "~/lib/content/queries";
import { PROCESS } from "~/lib/content/defaults";

const { slug } = Astro.params;
const service = slug ? await getService(slug) : undefined;
if (!service) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
const all = await getServices();
const next = all.find((s) => s.order === (service.order % 12) + 1);

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<PublicLayout
  title={service.name}
  description={service.outcome}
  moduleIndex={service.order - 1}
>
  <article>
    <header class="hero" data-chapter="service-hero">
      <div class="container grid">
        <div class="copy">
          <p class="mono-label" data-reveal>
            Service {String(service.order).padStart(2, "0")} / 12 · {service.name}
          </p>
          <h1 data-reveal>{service.outcome}</h1>
          <p class="support" data-reveal>{service.intro}</p>
        </div>
        <div class="stage">
          <FrameStage
            tl={`MODULE ${String(service.order).padStart(2, "0")}`}
            tr="STATE: ACTIVE"
            bl={service.name.toUpperCase().slice(0, 24)}
            br="FIG. 01"
          >
            <Poster state="focus" label={`Module ${service.order} isolated under studio light`} />
          </FrameStage>
        </div>
      </div>
    </header>

    <section class="usecases container" data-chapter="service-usecases">
      <p class="mono-label" data-reveal>What it looks like in a real business</p>
      <div class="cases">
        {
          service.useCases.map((c, i) => (
            <div class="case" data-reveal>
              <p class="mono-label">{String(i + 1).padStart(2, "0")}</p>
              <h2>{c.head}</h2>
              <p>{c.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="deliver container" data-reveal>
      <p class="mono-label">What the engagement delivers</p>
      <ul>
        {service.deliverables.map((d) => <li>{d}</li>)}
      </ul>
    </section>

    <section class="process container" data-chapter="service-process">
      <p class="mono-label" data-reveal>How we get there</p>
      <ol>
        {
          PROCESS.map((p) => (
            <li data-reveal>
              <span class="mono-label">{p.step}</span>
              <h2>{p.name}</h2>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="faq container">
      <p class="mono-label" data-reveal>Asked before every engagement</p>
      {
        service.faq.map((f) => (
          <details data-reveal>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>

    <section class="endcap container" data-chapter="service-end">
      <h2 data-reveal>Which workflow costs you the most hours?</h2>
      <div class="actions" data-reveal>
        <a class="cta cta--warm" href="/contact">Build with Aigenvora</a>
        {
          next && (
            <a class="cta" href={`/services/${next.slug}`}>
              Next · {String(next.order).padStart(2, "0")} {next.name}
            </a>
          )
        }
      </div>
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
</PublicLayout>

<style>
  .hero {
    padding-block: var(--space-stage) var(--space-4);
  }
  .grid {
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: var(--space-3);
    align-items: start;
  }
  h1 {
    font-size: var(--text-display);
    margin-block: var(--space-2);
    max-width: 16ch;
  }
  .support {
    color: var(--ink-2);
    font-size: var(--text-lg);
    max-width: 46ch;
  }
  .stage {
    min-height: 52vh;
    display: grid;
  }

  .usecases {
    padding-block: var(--space-4);
  }
  .cases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .case h2 {
    font-size: var(--text-xl);
    margin-block: var(--space-1) var(--space-2);
    max-width: 14ch;
  }
  .case p:last-child {
    color: var(--ink-2);
  }
  .case:nth-child(2) {
    margin-top: var(--space-4);
  }
  .case:nth-child(3) {
    margin-top: var(--space-2);
  }

  .deliver {
    padding-block: var(--space-3);
    border-top: 1px solid var(--hairline-soft);
  }
  .deliver ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-1) var(--space-3);
    max-width: 860px;
  }
  .deliver li {
    border-left: 2px solid var(--accent-electric);
    padding-left: 0.8rem;
    color: var(--ink-2);
  }

  .process {
    padding-block: var(--space-4);
    border-top: 1px solid var(--hairline-soft);
  }
  .process ol {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .process h2 {
    font-size: var(--text-lg);
    margin-block: var(--space-1);
  }
  .process p:last-child {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .faq {
    padding-block: var(--space-4);
    border-top: 1px solid var(--hairline-soft);
    max-width: calc(var(--grid-max) );
  }
  details {
    border-top: 1px solid var(--hairline);
    max-width: 70ch;
  }
  details:last-of-type {
    border-bottom: 1px solid var(--hairline);
  }
  summary {
    font-family: var(--font-display);
    font-weight: 600;
    padding: 0.9rem 0.2rem;
    cursor: pointer;
  }
  summary:hover {
    color: var(--accent-electric);
  }
  details p {
    color: var(--ink-2);
    padding: 0 0.2rem 1rem;
    max-width: 62ch;
  }

  .endcap {
    padding-block: var(--space-5);
  }
  .endcap h2 {
    font-size: var(--text-xl);
    max-width: 24ch;
    margin-bottom: var(--space-3);
  }
  .actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .grid,
    .cases,
    .process ol,
    .deliver ul {
      grid-template-columns: 1fr;
    }
    .stage {
      order: -1;
      min-height: 42vh;
    }
    .case:nth-child(2),
    .case:nth-child(3) {
      margin-top: 0;
    }
  }
</style>
