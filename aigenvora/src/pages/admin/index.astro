---
import AdminLayout from "~/layouts/AdminLayout.astro";
import { adminDb, col } from "~/lib/firebase/server";

const db = adminDb();
const [leads, projects, auditSnap, viewsSnap] = await Promise.all([
  db.collection(col("leads")).get(),
  db.collection(col("projects")).get(),
  db.collection(col("adminAudit")).orderBy("at", "desc").limit(8).get(),
  db.collection(col("pageviews")).orderBy("at", "desc").limit(300).get(),
]);
const newLeads = leads.docs.filter((d) => d.data()["status"] === "new").length;
const published = projects.docs.filter((d) => d.data()["status"] === "published").length;

const views = viewsSnap.docs.map((d) => d.data());
const countBy = (key: string): [string, number][] =>
  Object.entries(
    views.reduce<Record<string, number>>((acc, v) => {
      const k = String(v[key] || "—");
      acc[k] = (acc[k] ?? 0) + 1;
      return acc;
    }, {}),
  )
    .sort((a, b) => b[1] - a[1])
    .slice(0, 6);
const topCountries = countBy("country");
const topPaths = countBy("path");
const uniqueVisitors = new Set(views.map((v) => v["sid"])).size;
---

<AdminLayout title="Dashboard">
  <h1>Dashboard</h1>
  <div class="cards">
    <a class="panel stat" href="/admin/leads">
      <span class="n">{newLeads}</span>
      <span>new leads ({leads.size} total)</span>
    </a>
    <a class="panel stat" href="/admin/projects">
      <span class="n">{published}</span>
      <span>published projects ({projects.size} records)</span>
    </a>
    <a class="panel stat" href="/admin/services">
      <span class="n">12</span>
      <span>services (edit copy &amp; status)</span>
    </a>
  </div>

  <h2>Visitors (last {views.length} pageviews · {uniqueVisitors} unique)</h2>
  <div class="cards">
    <div class="panel">
      <p class="muted">By country</p>
      <table>
        <tbody>
          {topCountries.map(([k, n]) => <tr><td>{k}</td><td>{n}</td></tr>)}
          {views.length === 0 && <tr><td>No pageviews recorded yet.</td></tr>}
        </tbody>
      </table>
    </div>
    <div class="panel">
      <p class="muted">Top pages</p>
      <table>
        <tbody>
          {topPaths.map(([k, n]) => <tr><td>{k}</td><td>{n}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div>

  <h2>Recent activity</h2>
  <table>
    <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Target</th></tr></thead>
    <tbody>
      {
        auditSnap.docs.map((d) => {
          const x = d.data();
          return (
            <tr>
              <td>{String(x["at"]).slice(0, 16).replace("T", " ")}</td>
              <td>{x["actor"]}</td>
              <td>{x["action"]}</td>
              <td>{x["target"]}</td>
            </tr>
          );
        })
      }
      {auditSnap.empty && <tr><td colspan="4">No activity yet.</td></tr>}
    </tbody>
  </table>

  <style>
    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    .stat {
      display: grid;
      gap: 0.2rem;
      text-decoration: none;
      color: var(--dim);
    }
    .stat .n {
      font-size: 2rem;
      font-weight: 700;
      color: var(--text);
    }
    .muted {
      color: var(--dim);
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin: 0 0 0.5rem;
    }
    @media (max-width: 760px) {
      .cards {
        grid-template-columns: 1fr;
      }
    }
  </style>
</AdminLayout>
