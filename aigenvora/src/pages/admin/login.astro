---
import AdminLayout from "~/layouts/AdminLayout.astro";
import { verifySession } from "~/lib/admin/auth";

if (await verifySession(Astro.cookies)) {
  return Astro.redirect("/admin");
}
const error = Astro.url.searchParams.get("error") === "1";
---

<AdminLayout title="Sign in" bare>
  <div class="login">
    <form method="post" action="/api/admin/session" class="panel">
      <p class="mark">AIGENVORA ADMIN</p>
      {error && <p class="flash error">That didn't work. Check the email and password.</p>}
      <label>
        <span>Email</span>
        <input type="email" name="email" required autocomplete="username" />
      </label>
      <label>
        <span>Password</span>
        <input type="password" name="password" required autocomplete="current-password" />
      </label>
      <button type="submit">Sign in</button>
    </form>
  </div>

  <style>
    .login {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 1rem;
    }
    form {
      width: min(360px, 100%);
    }
    .mark {
      font-weight: 700;
      letter-spacing: 0.12em;
      font-size: 0.8rem;
      margin: 0 0 1.2rem;
    }
    button {
      width: 100%;
    }
  </style>
</AdminLayout>
