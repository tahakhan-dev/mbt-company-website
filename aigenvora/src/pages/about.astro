---
import PublicLayout from "~/layouts/PublicLayout.astro";
import { PRINCIPLES } from "~/lib/content/defaults";
import { getTeam } from "~/lib/content/queries";

const team = await getTeam();
const principles = [
  ...PRINCIPLES,
  {
    name: "Operate what you build",
    body: "We run products in production, so we design like the 3am page is coming to us. Because sometimes it is.",
  },
];

/**
 * Team portraits are owner-supplied per the rights ledger; the people section
 * ships its layout and copy now and receives photography when cleared —
 * no generic initials, no invented faces.
 */
---

<PublicLayout
  title="About"
  description="Why Aigenvora exists: AI should improve real workflows, not decorate products. Senior-team delivery across product, design, AI, data, cloud and security."
  sceneMode="decompose"
>
  <!-- Opens dark: the one route that does (storyboard route map) -->
  <header class="opening" data-chapter="about-opening">
    <div class="container">
      <p class="mono-label" data-reveal>About Aigenvora</p>
      <h1 data-reveal>Software should remove work.</h1>
      <p class="support" data-reveal>
        We started Aigenvora because too much of it adds work instead. We design, build and
        operate AI-powered software that removes repetitive work, connects fragmented systems
        and turns product ideas into scalable businesses.
      </p>
    </div>
  </header>

  <section class="stats container" aria-label="Company facts">
    <p class="mono-label strip" data-reveal>
      12 service lines · 13 products in production · 1 senior team · Your repo, your cloud, your code
    </p>
  </section>

  <section class="belief container" data-chapter="about-belief">
    <p class="mono-label" data-reveal>What we believe</p>
    <p class="statement" data-reveal>
      AI belongs inside real workflows, not on top of them as decoration.
    </p>
  </section>

  <section class="principles container" data-chapter="about-principles">
    <p class="mono-label" data-reveal>Principles</p>
    <div class="grid">
      {
        principles.map((p, i) => (
          <div class="principle" data-reveal>
            <span class="mono-label">{String(i + 1).padStart(2, "0")}</span>
            <h2>{p.name}</h2>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="how container" data-chapter="about-how">
    <p class="mono-label" data-reveal>How the disciplines work together</p>
    <p class="statement" data-reveal>
      Product, design, AI, data, cloud and security aren't departments here — they're one loop.
      The person who scopes your system helps build it; the person who builds it helps run it.
    </p>
    <div class="model" data-reveal>
      <p><b>Senior delivery.</b> No hand-off to a junior bench after the sales call.</p>
      <p><b>One channel.</b> Short loops, working software every week, decisions in writing.</p>
      <p><b>Global by default.</b> Remote-first delivery for startups and SMEs across markets.</p>
    </div>
  </section>

  <section class="team container" data-chapter="about-team">
    <p class="mono-label" data-reveal>People</p>
    <p class="statement" data-reveal>
      A small senior team — engineers, designers and operators who have shipped and run
      production systems across AI, SaaS, mobile and infrastructure.
    </p>
    {
      team.length > 0 && (
        <div class="members">
          {team.map((m) => (
            <div class="member" data-reveal>
              <span class="portrait" aria-hidden="true" />
              <b>{m.name}</b>
              <span class="mono-label">{m.role}</span>
              {m.bio && <p>{m.bio}</p>}
            </div>
          ))}
        </div>
      )
    }
    <p class="support" data-reveal>
      Portraits are published as each teammate approves them — real people, no stock faces.
    </p>
  </section>

  <section class="ways container">
    <p class="mono-label" data-reveal>Ways to work with us</p>
    <div class="ways-grid">
      <div data-reveal>
        <h2>Project build</h2>
        <p>A scoped system with milestones and a definition of done you sign off. Billed by milestone, documented as it ships, handed over clean.</p>
      </div>
      <div data-reveal>
        <h2>MVP sprint</h2>
        <p>Time-boxed from validation to launch, exactly as the <a href="/mvps">MVP page</a> describes it. Your accounts, your code, from the first commit.</p>
      </div>
      <div data-reveal>
        <h2>Managed cover</h2>
        <p>Monthly and cancellable: monitoring, updates, incident response and AI-quality reviews, per <a href="/services/maintenance-managed-ai">service 12</a>.</p>
      </div>
    </div>
  </section>

  <section class="endcap container">
    <h2 data-reveal>See the system in action.</h2>
    <div class="actions" data-reveal>
      <a class="cta cta--warm" href="/contact">Build with Aigenvora</a>
      <a class="cta" href="/work">Explore our work</a>
    </div>
  </section>
</PublicLayout>

<style>
  .opening {
    background: transparent;
    color: #f2f3f8;
    min-height: 150vh;
    display: flex;
    align-items: center;
    padding-block: var(--space-stage);
  }
  :global(html[data-tier="C"]) .opening,
  :global(html:not([data-tier])) .opening,
  :global(html[data-engine="failed"]) .opening {
    background: #030407;
  }
  .opening .mono-label,
  .opening .support {
    color: #9da4b3;
  }
  h1 {
    font-size: clamp(3rem, 14vw, 11rem);
    max-width: 12ch;
    margin-block: var(--space-2);
  }
  .support {
    color: var(--ink-2);
    font-size: var(--text-lg);
    max-width: 52ch;
  }

  section:not(.opening) {
    padding-block: var(--space-4);
  }
  .statement {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-display);
    max-width: 32ch;
    margin-top: var(--space-2);
  }

  .principles .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .principle h2 {
    font-size: var(--text-lg);
    margin-block: var(--space-1);
  }
  .principle p:last-child {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .principle:nth-child(2) {
    margin-top: var(--space-3);
  }
  .principle:nth-child(5) {
    margin-top: var(--space-3);
  }

  .model {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-3);
    max-width: 56ch;
    color: var(--ink-2);
  }
  .model b {
    color: var(--ink);
  }

  .stats {
    padding-block: var(--space-3) 0 !important;
  }
  .strip {
    border-block: 1px solid var(--hairline);
    padding-block: 0.8rem;
    font-size: 0.8rem;
  }

  .members {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
    max-width: 1000px;
  }
  .member {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }
  .portrait {
    aspect-ratio: 4 / 5;
    background:
      linear-gradient(160deg, var(--raised), var(--paper));
    border: 1px solid var(--hairline);
    margin-bottom: 0.4rem;
  }
  .member b {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
  .member p {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .team .support {
    margin-top: var(--space-3);
  }

  .ways {
    padding-block: var(--space-4);
    border-top: 1px solid var(--hairline-soft);
  }
  .ways-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
    max-width: 1000px;
  }
  .ways h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }
  .ways p {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .ways a {
    color: var(--accent-electric);
  }
  @media (max-width: 800px) {
    .ways-grid {
      grid-template-columns: 1fr;
    }
  }

  .endcap h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }
  .actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .principles .grid {
      grid-template-columns: 1fr;
    }
    .principle:nth-child(2),
    .principle:nth-child(5) {
      margin-top: 0;
    }
  }
</style>
