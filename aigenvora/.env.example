# Aigenvora V3 environment template. Copy to the repo root as .env.local
# (the app also reads aigenvora/.env.local). REAL VALUES ARE NEVER COMMITTED.

# Firebase Admin SDK service account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Web API key (admin login via Identity Toolkit REST).
# Either name works; the legacy NEXT_PUBLIC_ name is accepted for compatibility.
FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=

# Canonical site URL (used for canonical links, sitemap, origin checks)
PUBLIC_SITE_URL=https://aigenvora.com

# Firestore collection prefix. Leave unset/empty → the app uses "v3_".
# The e2e/test tooling may set an isolated prefix explicitly.
FIRESTORE_COLLECTION_PREFIX=
