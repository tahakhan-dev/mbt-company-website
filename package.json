{
  "name": "mbt-company-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MBT — AI software house marketing site + admin CMS + first-party visitor intelligence. Next.js 16 · Firebase (admin-SDK only) · Netlify · GSAP/R3F.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup:firebase": "node --env-file=.env.local --import tsx scripts/setup-firebase.mts",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.mts",
    "rollup": "node --env-file=.env.local --import tsx scripts/rollup.mts",
    "cleanup:e2e": "node --env-file=.env.local --import tsx scripts/cleanup-e2e.mts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "playwright test --config=playwright.smoke.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@netlify/functions": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/fiber": "^9.7.0",
    "@tiptap/core": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "three": "^0.182.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/three": "^0.182.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.3",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
